# -----------------------------------------------------------------------------
# run_atpg.tcl -- Modus stuck-at ATPG for the scan-inserted netlist.
#
#   cd p2_atpg
#   DFT_CHAINS=1 modus -files run_atpg.tcl        (or: make atpg CHAINS=1)
#
# Command forms are copied from the runmodus.atpg.tcl that Genus 21.14 writes
# itself during write_dft_atpg (see p2_scan/test_scripts/), because those are
# known to work on this install. Two things that will silently break it:
#
#   * build_model takes -cell <top cell name> and -techlib <verilog models>.
#     `-cell` is NOT where the library file goes.
#   * pin assignment is per chain count, so the file is generated below into
#     runs/c<N>/top.pinassign instead of being read from one shared file.
#
# The `modus` invocation differs between releases (some take -files, some want
# -legacy_ui -files, some read the script on stdin). Override without editing:
#   make atpg CHAINS=1 MODUS_FLAGS='-legacy_ui -files run_atpg.tcl'
# -----------------------------------------------------------------------------
set ::CHAINS 1
if {[info exists ::env(DFT_CHAINS)]} { set ::CHAINS $::env(DFT_CHAINS) }

set ::RUN runs/c$::CHAINS
file mkdir $::RUN

# ---- inputs produced by `make dft CHAINS=<N>` -------------------------------
set ::NETLIST [file join .. p2_scan $::RUN top_scan.v]
# Warn, do not exit: this script is also parse-checked off-server (no run tree),
# and `make atpg` already refuses to start without the netlist.
if {![file isfile $::NETLIST]} {
    puts "WARNING: $::NETLIST not found -- run 'make dft CHAINS=$::CHAINS' first"
}

# ---- pin assignment, regenerated for this chain count -----------------------
# Port suffix is 1-based (dft_sdi_1 for the first chain), the SI/SO channel
# index is 0-based (SI0). rst_n is +SC so the active-low reset stays inactive
# for the whole test; clk is -ES (test clock, no shift edges).
set ::PINASSIGN [file join $::RUN top.pinassign]
set fh [open $::PINASSIGN w]
puts $fh "# Generated by run_atpg.tcl for $::CHAINS chain(s)."
puts $fh "# Source of the syntax: p2_scan/test_scripts/top.FULLSCAN.pinassign"
puts $fh "assign pin=rst_n     test_function= +SC;"
puts $fh "assign pin=SE        test_function= +SE;"
puts $fh "assign pin=clk       test_function= -ES;"
for {set i 1} {$i <= $::CHAINS} {incr i} {
    set ch [expr {$i - 1}]
    puts $fh "assign pin=dft_sdi_$i test_function= SI$ch;"
    puts $fh "assign pin=dft_sdo_$i test_function= SO$ch;"
}
close $fh

# ---- database location ------------------------------------------------------
# Wipe the previous database: a half-built one from a failed attempt makes the
# next run's errors look unrelated to the real cause.
file delete -force $::RUN/tbdata
file delete -force $::RUN/testresults
set_db workdir ./$::RUN/tbdata
set   WORKDIR [get_db workdir]

set_option stdout summary

# check_log (from test_checks.tcl, shipped with Modus) stops the script on an
# ERROR in the tool log instead of ploughing on with a broken model. No-op if
# this install keeps the file elsewhere.
set ::STOP_ON_MSG_SEV ERROR
if {![info exists ::env(Install_Dir)] ||
    [catch {source [file join $::env(Install_Dir) bin 64bit test_checks.tcl]}]} {
    proc check_log {args} { }
}

# ---- build the logic model --------------------------------------------------
build_model \
    -cell               top \
    -techlib            ../lib/cells.v \
    -designsource       $::NETLIST \
    -allowmissingmodules no \
    -messagecounteach   100
check_log log_build_model

# ---- build + inspect the test model (DRC) -----------------------------------
build_testmode \
    -testmode       FULLSCAN \
    -assignfile     $::PINASSIGN \
    -modedef        FULLSCAN
check_log log_build_testmode_FULLSCAN

# Per-chain lengths and pin mapping in the log here. A chain of length 0, or a
# scan_in/scan_out that does not appear in the netlist, means the pinassign or
# the chain count is wrong -- fix that before trusting any coverage number.
report_test_structures \
    -testmode       FULLSCAN \
    -reportscanchain all
check_log log_report_test_structures_FULLSCAN

verify_test_structures \
    -messagecount   TSV-016=10,TSV-024=10,TSV-315=10,TSV-027=10 \
    -testmode       FULLSCAN
check_log log_verify_test_structures_FULLSCAN

# ---- faults + patterns ------------------------------------------------------
build_faultmodel \
    -includedynamic no
check_log log_build_faultmodel

create_logic_tests \
    -experiment     top_atpg \
    -testmode       FULLSCAN
check_log log_create_logic_tests_FULLSCAN_top_atpg

write_toggle_gram \
    -experiment     top_atpg \
    -testmode       FULLSCAN

write_vectors \
    -inexperiment   top_atpg \
    -testmode       FULLSCAN \
    -language       verilog \
    -scanformat     parallel
check_log log_write_vectors_FULLSCAN_top_atpg

commit_tests \
    -inexperiment   top_atpg \
    -testmode       FULLSCAN
check_log log_commit_tests_FULLSCAN_top_atpg

# -----------------------------------------------------------------------------
# KPI emission -- scripts/collect_results.py reads $::RUN/atpg_kpi.txt.
#
# The numbers come from what Modus and Genus already wrote to disk: the
# tbdata/modus_metrics fault accounting, the per-command logs under
# testresults/logs/, and Genus's scan chain report. Anything this release words
# differently is written as NA rather than guessed: a plausible-looking wrong
# coverage number in results_table.md is worse than a blank one.
# -----------------------------------------------------------------------------
set ::KPI [file join $::RUN atpg_kpi.txt]
set fh [open $::KPI w]
puts $fh "# Generated by run_atpg.tcl for $::CHAINS chain(s) -- do not hand-edit."
close $fh

proc atpg_kpi {name value} {
    if {![string length $value]} { set value NA }
    set fh [open $::KPI a]
    puts $fh "$name $value"
    close $fh
}

# Last progress row of create_logic_tests. Modus reprints the whole table as
# ATPG advances, so the final row is the cumulative result:
#
#   INFO (TDA-220):    Sim.    Eff.  Detected    Tmode    Global     Untested
#   INFO (TDA-220):     91      88        22   99.99%   99.99%            0
#
# 'Global' is test coverage (ATPG coverage over all faults); 'Untested' is what
# was left undetected. Returns {} if the wording changed.
proc atpg_tda220_last {} {
    set f [file join $::RUN testresults logs log_create_logic_tests_FULLSCAN_top_atpg]
    if {![file isfile $f]} { return {} }
    set fh [open $f r]
    set txt [read $fh]
    close $fh
    set last {}
    foreach line [split $txt \n] {
        if {[string first "TDA-220" $line] < 0} { continue }
        if {[regexp {([0-9]+)\s+([0-9]+)\s+([0-9]+)\s+([0-9.]+)%\s+([0-9.]+)%\s+([0-9]+)\s+([0-9]+:[0-9]+(?:\.[0-9]+)?)} \
                $line -> sim eff det tmode glob unt el]} {
            set last [list $sim $eff $det $tmode $glob $unt $el]
        }
    }
    return $last
}

# Longest scan chain, from the report Genus wrote for this chain count.
proc atpg_longest_chain {} {
    set f [file join .. p2_scan $::RUN scan_chains.rpt]
    if {![file isfile $f]} { return "" }
    set fh [open $f r]
    set txt [read $fh]
    close $fh
    set max ""
    foreach line [split $txt \n] {
        if {[regexp -nocase {length\s*:?\s*([0-9]+)} $line -> n]} {
            if {$max eq "" || $n > $max} { set max $n }
        }
    }
    return $max
}

# commit_tests leaves tbdata/modus_metrics behind as plain "key value" lines:
#
#   atpg.stats:static.total_faults 4556
#   atpg.stats:static.tested_faults 4556
#   atpg.stats:static.possible_faults 0
#   atpg.stats:static.untested_faults 0
#   atpg.stats:static.atcov 100.000000%
#   atpg.testmode:FULLSCAN.num_tests 91
#
# That beats scraping prose out of the logs, so the fault KPIs come from here.
# Only the global keys are taken: the same names reappear per testmode, e.g.
# atpg.testmode:FULLSCAN.experiment:top_atpg.stats:static.tested_faults, and
# matching those too would just overwrite the answer with a copy of itself.
proc atpg_metrics {} {
    set d [dict create]
    set f [file join $::RUN tbdata modus_metrics]
    if {![file isfile $f]} { return $d }
    set fh [open $f r]
    set txt [read $fh]
    close $fh
    set pat {^(atpg\.stats:static\.[a-z_]+|atpg\.testmode:FULLSCAN\.num_tests)\s+(\S+)\s*$}
    foreach line [split $txt \n] {
        if {[regexp $pat $line -> key value]} { dict set d $key $value }
    }
    return $d
}

# One metrics value by key, percent sign stripped, "" when absent.
proc atpg_met {d key} {
    if {![dict exists $d $key]} { return "" }
    set v [dict get $d $key]
    regsub {%$} $v "" v
    return $v
}

atpg_kpi LONGEST_CHAIN [atpg_longest_chain]

set ::MET [atpg_metrics]
set ::TDA [atpg_tda220_last]
if {![llength $::MET] && [llength $::TDA] != 7} {
    puts "NOTE: no tbdata/modus_metrics and no TDA-220 table -- ATPG KPIs written as NA"
}

# Coverage: the metrics file is derived from the final fault accounting, while
# the interactive TDA-220 table on this release printed 99.99% for a run whose
# own totals are 4556 tested of 4556. Prefer the metrics, but say so when they
# disagree, because quoting the wrong one of the two is an interview trap.
set ::COV [atpg_met $::MET atpg.stats:static.atcov]
if {$::COV eq "" && [llength $::TDA] == 7} { set ::COV [lindex $::TDA 4] }
if {$::COV ne "" && [llength $::TDA] == 7} {
    set tda [lindex $::TDA 4]
    if {[string is double -strict $tda] && [string is double -strict $::COV]} {
        if {abs($tda - $::COV) > 0.005} {
            puts "NOTE: TDA-220 reported ${tda}% coverage, modus_metrics reports ${::COV}% -- using the metrics value"
        }
    }
}
atpg_kpi TEST_COVERAGE $::COV

# Committed tests: 90 logic + 1 scan on this design. In full scan one test is
# one scan load, so this is also the pattern count results_table.md multiplies
# by (chain length + 1).
set ::TESTS [atpg_met $::MET atpg.testmode:FULLSCAN.num_tests]
if {[llength $::TDA] == 7} {
    lassign $::TDA sim eff det tmode glob unt el
    if {$::TESTS eq ""} { set ::TESTS $sim }
    atpg_kpi NUM_TESTS           $::TESTS
    atpg_kpi NUM_EFFECTIVE_TESTS $eff
    # Elapsed is mm:ss.cc; results_table.md wants plain seconds.
    set parts [split $el :]
    atpg_kpi ATPG_RUNTIME [format %.2f [expr {[lindex $parts 0] * 60 + [lindex $parts 1]}] ]
} else {
    atpg_kpi NUM_TESTS           $::TESTS
    atpg_kpi NUM_EFFECTIVE_TESTS ""
    atpg_kpi ATPG_RUNTIME        ""
}
atpg_kpi PATTERNS $::TESTS

set ::UNTT [atpg_met $::MET atpg.stats:static.untested_faults]
if {$::UNTT eq "" && [llength $::TDA] == 7} { set ::UNTT [lindex $::TDA 5] }
atpg_kpi UNDETECTED_FAULTS $::UNTT

atpg_kpi TOTAL_FAULTS      [atpg_met $::MET atpg.stats:static.total_faults]
atpg_kpi DETECTED_FAULTS   [atpg_met $::MET atpg.stats:static.tested_faults]
# ATPG-untestable faults are the ones ATPG gave up on by proof, not by failure.
atpg_kpi UNTESTABLE_FAULTS [atpg_met $::MET atpg.stats:static.possible_faults]

exit
